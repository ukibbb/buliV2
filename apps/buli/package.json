{
  "name": "@buli/buli",
  "private": true,
  "type": "module",
  "bin": {
    "buli": "./src/main.ts"
  },
  "scripts": {
    "start": "bun src/main.ts",
    "dev": "SHOW_CONSOLE=1 bun --watch src/main.ts",
    "dev:quiet": "bun --watch src/main.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@buli/common": "workspace:*",
    "@buli/engine": "workspace:*",
    "@buli/tui": "workspace:*",
    "yargs": "^18.0.0"
  },
  "devDependencies": {
    "@types/yargs": "^17.0.35"
  }
}
