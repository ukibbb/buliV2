{
  "name": "@ukibbb/buli",
  "version": "0.1.0-rc.6",
  "private": true,
  "license": "MIT",
  "type": "module",
  "bin": {
    "buli": "./cli/main.ts"
  },
  "packageManager": "bun@1.3.12",
  "engines": {
    "bun": ">=1.3.12"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "SHOW_CONSOLE=0 bun test ./test",
    "dev": "BULI_DEVELOPMENT=1 SHOW_CONSOLE=1 bun cli/main.ts",
    "dev:quiet": "BULI_DEVELOPMENT=1 bun --watch cli/main.ts",
    "start": "BULI_DEVELOPMENT=1 bun cli/main.ts",
    "build:local": "mkdir -p dist && bun build --compile ./cli/main.ts --outfile ./dist/buli",
    "bundle:local": "bun scripts/build-release.ts"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.16",
    "@opentui/core": "^0.5.6",
    "@opentui/react": "^0.5.6",
    "ai": "^7.0.31",
    "open": "10.1.2",
    "react": "^19.2.7",
    "typebox": "1.3.7",
    "yargs": "^18.0.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19",
    "@types/yargs": "^17.0.35",
    "typescript": "^5"
  }
}
