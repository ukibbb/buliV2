{
  "name": "buli",
  "private": true,
  "type": "module",
  "bin": {
    "buli": "./cli/main.ts"
  },
  "packageManager": "bun@1.3.12",
  "engines": {
    "bun": ">=1.3.12"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test",
    "dev": "SHOW_CONSOLE=1 bun --watch cli/main.ts",
    "dev:quiet": "bun --watch cli/main.ts",
    "start": "bun cli/main.ts",
    "common": "bun src/common/index.ts",
    "engine": "bun src/engine/index.ts",
    "providers": "bun src/providers/index.ts",
    "tui": "bun cli/main.ts"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.16",
    "@opentui/core": "^0.4.3",
    "@opentui/react": "^0.4.3",
    "ai": "^7.0.31",
    "react": "^19.2.7",
    "yargs": "^18.0.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19",
    "@types/yargs": "^17.0.35",
    "typescript": "^5"
  }
}
